<h1>商品一覧</h1>

<% @products.each do |product| %>
  <p>
    商品名：<%= product.name %>
    価格：<%= product.price %>円

    <%= link_to "削除",
        product_path(product),
        data: { turbo_method: :delete } %>

    <%= link_to "カートに追加",
        new_cartitem_path(product_id: product.id) %>
  </p>
<% end %>

<hr>

<p>
  <%= link_to "商品を追加する", new_product_path %>
</p>

<p>
  <%= link_to "カートを見る", cart_path(current_cart) %>
</p>    